  create or replace temp table dbt_cdc_reduced as
  select * exclude (_cdc_op_raw)
  from dbt_cdc_norm
  qualify row_number() over (partition by "id" order by _cdc_ver desc, _cdc_hash) = 1;

  -- a replayed version must carry the same contents as what was already applied
  select error('cdc strategy: change for key ' || concat_ws(',', cast(r."id" as varchar)) || ' at version ' || cast(r._cdc_ver as varchar) || ' conflicts with a different change already applied at that version in model cdc_basic')
  from dbt_cdc_reduced r
  join "memory"."test17949084694606583797_test_incremental_cdc"."cdc_basic__dbt_cdc_state" s on r."id" = s."id"
  where r._cdc_ver = s._dbt_cdc_version and r._cdc_hash <> s._dbt_cdc_hash;

  -- keep only changes newer than what the state table has already applied
  create or replace temp table dbt_cdc_apply as
  select r.*
  from dbt_cdc_reduced r
  left join "memory"."test17949084694606583797_test_incremental_cdc"."cdc_basic__dbt_cdc_state" s on r."id" = s."id"
  where s."id" is null or r._cdc_ver > s._dbt_cdc_version;

  -- apply to the business table: replace upserted keys, remove deleted keys
  delete from "memory"."test17949084694606583797_test_incremental_cdc"."cdc_basic" as t
  using dbt_cdc_apply as a
  where t."id" = a."id";

  insert into "memory"."test17949084694606583797_test_incremental_cdc"."cdc_basic" ("id", "name", "val")
  select "id", "name", "val" from dbt_cdc_apply
  where _cdc_op = 'upsert';

  -- record the applied versions (deletes included, as tombstones)
  delete from "memory"."test17949084694606583797_test_incremental_cdc"."cdc_basic__dbt_cdc_state" as s
  using dbt_cdc_apply as a
  where s."id" = a."id";

  insert into "memory"."test17949084694606583797_test_incremental_cdc"."cdc_basic__dbt_cdc_state" ("id", _dbt_cdc_version, _dbt_cdc_op, _dbt_cdc_hash)
  select "id", _cdc_ver, _cdc_op, _cdc_hash from dbt_cdc_apply;

  drop table dbt_cdc_norm;
  drop table dbt_cdc_reduced;
  drop table dbt_cdc_apply;

  
