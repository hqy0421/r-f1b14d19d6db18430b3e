  select error('cdc strategy: null version for key ' || concat_ws(',', cast("id" as varchar)) || ' in model cdc_basic')
  from dbt_cdc_norm
  where _cdc_ver is null;

  -- every operation must map to upsert or delete
  select error('cdc strategy: invalid operation ''' || coalesce(_cdc_op_raw, '<null>') || ''' for key ' || concat_ws(',', cast("id" as varchar)) || ' in model cdc_basic; expected one of DELETE, UPSERT (case-insensitive)')
  from dbt_cdc_norm
  where _cdc_op is null;

  -- within the batch, rows for one key at its highest version must be identical
  select error('cdc strategy: conflicting contents at version ' || cast(_cdc_ver as varchar) || ' for key ' || concat_ws(',', cast("id" as varchar)) || ' in model cdc_basic')
  from (
    select "id", _cdc_ver, _cdc_hash
    from dbt_cdc_norm
    qualify rank() over (partition by "id" order by _cdc_ver desc) = 1
