         md5(concat_ws(chr(29), coalesce(__dbt_cdc_op, chr(30)), coalesce(cast("id" as varchar), chr(30)), coalesce(cast("name" as varchar), chr(30)), coalesce(cast("val" as varchar), chr(30)))) as __dbt_cdc_hash
  from parsed;

