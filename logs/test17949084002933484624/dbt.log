  -- normalize the batch: cast the version, map the operation, hash the content
  create or replace temp table dbt_cdc_norm as
  with parsed as (
    select "id", "name", "val",
           cast("_cdc_version" as bigint) as _cdc_ver,
           case
             when upper(cast("_cdc_op" as varchar)) in ('DELETE') then 'delete'
             when upper(cast("_cdc_op" as varchar)) in ('UPSERT') then 'upsert'
           end as _cdc_op,
           cast("_cdc_op" as varchar) as _cdc_op_raw
    from "cdc_deletes__dbt_tmp20261117174014303358"
  )
  select *,
         md5(concat_ws(chr(29), coalesce(_cdc_op, chr(30)), coalesce(cast("id" as varchar), chr(30)), coalesce(cast("name" as varchar), chr(30)), coalesce(cast("val" as varchar), chr(30)))) as _cdc_hash
  from parsed;

