  create table if not exists "memory"."test17949086893234885592_test_incremental_cdc"."cdc_deletes__dbt_cdc_state" as
  select "id",
         cast(null as bigint) as _dbt_cdc_version,
         cast(null as varchar) as _dbt_cdc_op,
         cast(null as varchar) as _dbt_cdc_hash
  from "cdc_deletes__dbt_tmp20261117174506403498"
  where 1=0;

  -- normalize the batch: cast the version, map the operation, hash the content
  create or replace temp table dbt_cdc_norm as
  with parsed as (
    select "id", "name", "val",
           cast("_cdc_version" as bigint) as _cdc_ver,
           case
             when upper(cast("_cdc_op" as varchar)) in ('DELETE') then 'delete'
             when upper(cast("_cdc_op" as varchar)) in ('UPSERT') then 'upsert'
           end as _cdc_op,
           cast("_cdc_op" as varchar) as _cdc_op_raw
    from "cdc_deletes__dbt_tmp20261117174506403498"
  )
  select *,
         md5(concat_ws(chr(29), coalesce(_cdc_op, chr(30)), coalesce(cast("id" as varchar), chr(30)), coalesce(cast("name" as varchar), chr(30)), coalesce(cast("val" as varchar), chr(30)))) as _cdc_hash
  from parsed;

  -- every change must carry its business key
  select error('cdc strategy: null value in unique_key column(s) (id) in model cdc_deletes')
  from dbt_cdc_norm
  where "id" is null;

  -- every change must carry a version
  select error('cdc strategy: null version for key ' || concat_ws(',', cast("id" as varchar)) || ' in model cdc_deletes')
  from dbt_cdc_norm
  where _cdc_ver is null;

  -- every operation must map to upsert or delete
  select error('cdc strategy: invalid operation ''' || coalesce(_cdc_op_raw, '<null>') || ''' for key ' || concat_ws(',', cast("id" as varchar)) || ' in model cdc_deletes; expected one of DELETE, UPSERT (case-insensitive)')
  from dbt_cdc_norm
  where _cdc_op is null;

