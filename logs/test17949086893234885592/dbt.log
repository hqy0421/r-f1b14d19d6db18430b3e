  select *,
         md5(concat_ws(chr(29), coalesce(_cdc_op, chr(30)), coalesce(cast("id" as varchar), chr(30)), coalesce(cast("name" as varchar), chr(30)), coalesce(cast("val" as varchar), chr(30)))) as _cdc_hash
  from parsed;

