  delete from "memory"."test17949086893234885592_test_incremental_cdc"."cdc_hooked" as t
  using dbt_cdc_apply as a
  where t."id" = a."id";

  insert into "memory"."test17949086893234885592_test_incremental_cdc"."cdc_hooked" ("id", "name", "val")
  select "id", "name", "val" from dbt_cdc_apply
  where _cdc_op = 'upsert';

