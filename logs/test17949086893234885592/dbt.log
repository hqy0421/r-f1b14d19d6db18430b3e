           case
             when upper(cast("_cdc_op" as varchar)) in ('DELETE') then 'delete'
             when upper(cast("_cdc_op" as varchar)) in ('UPSERT') then 'upsert'
           end as _cdc_op,
           cast("_cdc_op" as varchar) as _cdc_op_raw
    from "cdc_replay__dbt_tmp20261117174455712923"
