  select error('cdc strategy: invalid operation ''' || coalesce(_cdc_op_raw, '<null>') || ''' for key ' || concat_ws(',', cast("id" as varchar)) || ' in model cdc_tombstone; expected one of DELETE, UPSERT (case-insensitive)')
  from dbt_cdc_norm
