        from duckdb_tables() t
        where upper(t.database_name) = upper('memory')

        union all

        select
            v.database_name as table_database,
            v.schema_name as table_schema,
            v.view_name as table_name,
            'VIEW' as table_type,
            v.comment as table_comment
        from duckdb_views() v
        where upper(v.database_name) = upper('memory')
    ) catalog_tables
      
        where (

                (
                    upper(table_schema) = upper('test17949078044951484871_test_basic')
                    and upper(table_name) = upper('added')
                ) or 

                (
                    upper(table_schema) = upper('test17949078044951484871_test_basic')
                    and upper(table_name) = upper('base')
                ) or 

                (
                    upper(table_schema) = upper('test17949078044951484871_test_basic')
                    and upper(table_name) = upper('incremental')
                ))
    
    ),
    columns as (
      select *
    from (
        select
            c.database_name as table_database,
            c.schema_name as table_schema,
            c.table_name as table_name,
