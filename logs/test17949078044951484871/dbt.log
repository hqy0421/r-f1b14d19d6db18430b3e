                    and upper(table_name) = upper('added')
                ) or 

                (
                    upper(table_schema) = upper('test17949078044951484871_test_basic')
                    and upper(table_name) = upper('base')
                ) or 

                (
                    upper(table_schema) = upper('test17949078044951484871_test_basic')
                    and upper(table_name) = upper('incremental')
                ))
    
    )
    select
        tables.table_database,
        tables.table_schema,
        tables.table_name,
        tables.table_type,
        tables.table_comment,
        columns.column_name,
        columns.column_index,
        columns.column_type,
        columns.column_comment,
        null as table_owner
    from tables
    join columns using (table_database, table_schema, table_name)
    order by table_schema, table_name, column_index
  
  
